# Copy to .env and fill in. .env is gitignored.

# --- Garmin Connect ---
# Your normal Garmin Connect login. Used once to mint OAuth tokens, which are
# then cached in GARMIN_TOKEN_STORE so subsequent syncs don't need the password.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_STORE=.garmin_tokens

# --- Claude (for the AI Coach tab) ---
# Without a key the app still works: the deterministic analytics engine produces
# all metrics and findings, you just don't get the narrative coaching layer.
ANTHROPIC_API_KEY=
SMART_ANALYTICS_MODEL=claude-opus-5

# --- Local storage ---
SMART_ANALYTICS_DB=data/smart_analytics.db

# --- Training preferences used by the analytics ---
# Used to derive heart-rate zones. Leave blank to infer from your data.
MAX_HR=
RESTING_HR=
# Weekly per-muscle "effective set" target range for the strength balance model.
WEEKLY_SETS_MIN=10
WEEKLY_SETS_MAX=20
