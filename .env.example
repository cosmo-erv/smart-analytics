# Copy to .env and fill in. .env is gitignored.

# --- Garmin Connect ---
# Your normal Garmin Connect login. Used once to mint OAuth tokens, which are
# then cached in GARMIN_TOKEN_STORE so subsequent syncs don't need the password.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_STORE=.garmin_tokens

# --- AI coach: set ONE of these ---
# Without a key the app still works: the deterministic analytics engine produces
# all metrics and findings, you just don't get the narrative coaching layer.
ANTHROPIC_API_KEY=
SMART_ANALYTICS_MODEL=claude-opus-5

# ...or use OpenAI instead. Set OPENAI_MODEL to a model your account can reach
# that supports structured outputs (gpt-4.1, gpt-4o and newer all do).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ...or run a model locally, for free, with no account and no credits. Anything
# speaking the OpenAI API works — Ollama, LM Studio, llama.cpp. Set the base URL
# and the model name; the key is ignored by these servers and can stay empty.
#   OPENAI_BASE_URL=http://localhost:11434/v1     # Ollama
#   OPENAI_MODEL=llama3.1
OPENAI_BASE_URL=

# Which one to use when both keys are set: auto | anthropic | openai.
# "auto" picks whichever key is present, preferring Anthropic if both are.
AI_PROVIDER=auto

# --- Local storage ---
SMART_ANALYTICS_DB=data/smart_analytics.db

# --- Training preferences used by the analytics ---
# Used to derive heart-rate zones. Leave blank to infer from your data.
MAX_HR=
RESTING_HR=
# Weekly per-muscle "effective set" target range for the strength balance model.
WEEKLY_SETS_MIN=10
WEEKLY_SETS_MAX=20
